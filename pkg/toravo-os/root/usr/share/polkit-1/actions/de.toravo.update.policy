<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Toravo OS</vendor>
  <action id="de.toravo.update">
    <description>Toravo Update: check, configure or roll back system updates</description>
    <description xml:lang="de">Toravo Update: Updates prüfen, einstellen oder zurücknehmen</description>
    <message>Toravo Update needs your password to change the system.</message>
    <message xml:lang="de">Toravo Update braucht dein Passwort, um das System zu ändern.</message>
    <icon_name>system-software-update</icon_name>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/toravo-update</annotate>
  </action>
</policyconfig>
