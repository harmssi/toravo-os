#!/bin/bash
. /usr/lib/toravo/locale.sh
if [ "$(toravo_ui)" = en ]; then L=(Lock "Log out" Restart "Shut down"); else L=(Sperren Abmelden Neustart Ausschalten); fi
choice=$(printf '󰌾  %s\n󰍃  %s\n󰜉  %s\n󰐥  %s\n' "${L[@]}" | fuzzel --dmenu --prompt '❯ ' --lines 4 --width 26)
case "$choice" in
  *"${L[0]}") loginctl lock-session ;;
  *"${L[1]}") if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then hyprctl dispatch 'hl.dsp.exit()'; else labwc --exit 2>/dev/null || loginctl terminate-session "$XDG_SESSION_ID"; fi ;;
  *"${L[2]}") systemctl reboot ;;
  *"${L[3]}") systemctl poweroff ;;
esac
